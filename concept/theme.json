{
  "id": "acrylic",
  "name": "Acrylic",
  "description": "Warm paper, black ink and white label pills; the charms are the only colour on the home, one flat flood colour per project page, mono caps in square ruled boxes.",
  "inspiredBy": ["lib-gass-rows", "lib-gass-color", "lib-an", "lib-k95-hover"],
  "colors": { "paper": "#f2f1ef", "ink": "#0a0a0a", "accent": "#ffffff", "mist": "#efece4", "muted": "#6f6e6a" },
  "palette": [
    { "name": "Rool orange", "value": "#ff5a00" },
    { "name": "Apuro blue", "value": "#2b2bff" },
    { "name": "Booklet pink", "value": "#ff2e93" },
    { "name": "Gabagool pink", "value": "#ff9ccf" },
    { "name": "Gabagool red", "value": "#a3161c" },
    { "name": "Chrome", "value": "#cfcfcf" }
  ],
  "fonts": {
    "sans": { "family": "DM Mono", "fallback": "ui-monospace, Menlo, monospace", "google": "DM+Mono:wght@400;500" },
    "display": { "family": "Inter Tight", "fallback": "Arial, sans-serif", "google": "Inter+Tight:wght@500" },
    "mono": { "family": "DM Mono", "fallback": "ui-monospace, Menlo, monospace", "google": "DM+Mono:wght@400;500" }
  },
  "type": [
    { "name": "headline", "size": "clamp(64px, 13vw, 220px)", "leading": "0.92", "tracking": "-0.06em", "weight": 500 },
    { "name": "title", "size": "clamp(22px, 3vw, 44px)", "leading": "1", "tracking": "-0.04em", "weight": 500 },
    { "name": "lead", "size": "clamp(14px, 1.15vw, 17px)", "leading": "1.55", "tracking": "-0.01em", "weight": 400 },
    { "name": "body", "size": "11px", "leading": "1.35", "tracking": "0.05em", "weight": 400 }
  ],
  "radius": "0px",
  "ease": { "out-expo": "cubic-bezier(0.16, 1, 0.3, 1)", "in-out-expo": "cubic-bezier(0.87, 0, 0.13, 1)" }
}
